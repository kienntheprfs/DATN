@startuml LoginActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
}
</style>

title Luồng hoạt động Đăng nhập (Login)

|User|
start
:Truy cập trang Đăng nhập;
:Nhập Email và Mật khẩu;
:Nhấn nút "Đăng nhập";

|Frontend|
:Kiểm tra dữ liệu rỗng;
if (Đã nhập đủ?) then (Có)
  :Gửi thông tin đăng nhập đến API;
  
  |API Gateway|
  :Xác thực với Database;
  if (Thông tin chính xác?) then (Có)
    :Tạo cặp JWT (Access & Refresh Token);
    :Trả về Tokens cho Client;
    
    |Frontend|
    :Lưu trữ Tokens an toàn;
    :Chuyển hướng vào màn hình chính;
    stop
  else (Không)
    |API Gateway|
    :Trả về lỗi 401 (Unauthorized);
    |Frontend|
    :Hiển thị lỗi sai tài khoản/mật khẩu;
    kill
  endif
else (Không)
  |Frontend|
  :Yêu cầu điền đầy đủ thông tin;
  kill
endif

@enduml