@startuml RegistrationActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
}
</style>

title Luồng hoạt động Đăng ký tài khoản (Registration)

|User|
start
:Truy cập trang Đăng ký;
:Nhập thông tin (Họ tên, Email, Mật khẩu);
:Nhấn nút "Đăng ký";

|Frontend|
:Kiểm tra tính hợp lệ của form;
if (Dữ liệu hợp lệ?) then (Có)
  :Gửi dữ liệu đến API;
  
  |API Gateway|
  :Kiểm tra Email trong Database;
  if (Email đã tồn tại?) then (Có)
    :Trả về lỗi 409 (Conflict);
    |Frontend|
    :Hiển thị lỗi trùng tài khoản;
    kill
  else (Không)
    |API Gateway|
    :Tạo tài khoản mới;
    :Tạo cặp JWT (Access & Refresh Token);
    :Trả về dữ liệu User & Tokens;
    
    |Frontend|
    :Lưu trữ Tokens an toàn;
    :Hiển thị thông báo thành công;
    :Chuyển hướng vào màn hình chính;
    stop
  endif
else (Không)
  |Frontend|
  :Hiển thị các lỗi Validation;
  kill
endif

@enduml