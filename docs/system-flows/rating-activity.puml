@startuml RatingActivitySimplified
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Đánh giá Câu trả lời của hệ thống

|Người dùng|
start
:Đọc phản hồi từ hệ thống;

if (Thực hiện đánh giá?) then (Có)
  :Nhấn biểu tượng Thích (Like)\nhoặc Không thích (Dislike);
  
  if (Loại đánh giá?) then (Không thích)
    |Giao diện (Frontend)|
    :Hiển thị cửa sổ góp ý (Pop-up);
    
    |Người dùng|
    :Chọn lý do đánh giá sẵn có\nhoặc nhập bình luận chi tiết;
    :Nhấn nút "Gửi";
  else (Thích)
  endif
  
  |Giao diện (Frontend)|
  :Gửi dữ liệu đánh giá;
  
  |Hệ thống BK-TBOT|
  :Lưu trữ dữ liệu vào CSDL;
  note right: Phục vụ tính toán và cập nhật\ncác chỉ số chất lượng mô hình
  
  |Giao diện (Frontend)|
  :Hiển thị thông báo "Cảm ơn";
  
else (Không)
  |Người dùng|
  :Tiếp tục hội thoại;
endif

stop

@enduml