@startuml CreateManualFAQActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Tạo Manual FAQ

|Người dùng|
start
:Nhập câu hỏi và câu trả lời;

|Giao diện (API)|
:Gọi POST /faqs/manual;
note right: Payload: question, answer

|Hệ thống BK-TBOT|
:Tạo FAQ record trong PostgreSQL;
note right: FAQSource.MANUAL

if (Tạo thành công?) then (Có)
  :Embed question với Hybrid Search;
  note right: Tạo dense + sparse vectors

  :Upsert vector vào Qdrant FAQ collection;

  :Trả về FAQ response;

  |Giao diện (API)|
  :Trả về 201 Created;

  |Người dùng|
  :Nhận FAQ mới tạo;
  stop

else (Không)
  :Báo lỗi 500;

  |Giao diện (API)|
  :Trả về lỗi server;

  |Người dùng|
  :Nhận thông báo lỗi;
  stop
endif
@enduml