@startuml NavigationChatActivitySimplified
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Tìm đường qua Chatbot

|Người dùng|
start
:Tại giao diện Chat;
:Hỏi vị trí hoặc yêu cầu chỉ đường;
note right: VD: "Thư viện ở đâu?"\nhoặc "Đường đi A101?"

|Giao diện (Frontend)|
:Gửi yêu cầu phân tích;

|Hệ thống BK-TBOT|
:Phân tích ngôn ngữ và trích xuất địa điểm;
:Tìm kiếm địa điểm trong CSDL;

if (Tìm thấy địa điểm?) then (Có)
  
  if (Là yêu cầu chỉ đường?) then (Có)
    :Tính toán lộ trình tối ưu;
    note right: Sử dụng thuật toán NetworkX
    :Tổng hợp lộ trình và bản đồ thu nhỏ (Mini-map);
  else (Không, chỉ hỏi vị trí)
    :Tổng hợp thông tin vị trí địa điểm;
  endif
  
else (Không)
  :Tìm kiếm gần đúng (Fuzzy Search);
  :Tổng hợp danh sách địa điểm gợi ý;
endif

:Trả về dữ liệu phản hồi;

|Giao diện (Frontend)|
:Hiển thị kết quả ngay trong khung chat;
note right: Hiện Mini-map, hướng dẫn ngắn gọn\nhoặc danh sách gợi ý

|Người dùng|
:Đọc thông tin và xem bản đồ thu nhỏ;

if (Muốn xem bản đồ lớn?) then (Có)
  :Nhấn nút phóng to / Mở bản đồ;
  |Giao diện (Frontend)|
  :Chuyển hướng sang trang Bản đồ\n(Navigation Flow);
else (Không)
endif

stop

@enduml