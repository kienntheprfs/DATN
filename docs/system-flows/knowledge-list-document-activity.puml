@startuml ListDocumentActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Liệt kê Documents

|Người dùng|
start
:Người dùng mở trang quản lý tài liệu;

|Giao diện (API)|
:Gọi GET /documents;
note right: Query params: skip, limit, storage_id

|Hệ thống BK-TBOT|
:Query documents từ PostgreSQL;
note right: Phân trang + lọc theo storage_id

:Gọi DocumentRepository.get_list();

if (Có documents?) then (Có)
  :Trả về danh sách DocumentResponse;

  |Giao diện (API)|
  :Trả về 200 OK;

  |Người dùng|
  :Hiển thị danh sách documents;
  note right: Tiêu đề, Trạng thái, Ngày tạo

else (Không)
  :Trả về danh sách rỗng;

  |Giao diện (API)|
  :Trả về 200 OK (empty list);

  |Người dùng|
  :Hiển thị "Không có tài liệu nào";
  stop
endif
@enduml