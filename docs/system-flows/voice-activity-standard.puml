@startuml VoiceActivitySimplified
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Tương tác bằng Giọng nói (Voice Mode)

|Người dùng|
start
repeat
  :Nhấn biểu tượng Micro;
  
  |Giao diện (Frontend)|
  :Kiểm tra quyền truy cập Micro;
  
  if (Được cấp quyền?) then (Từ chối)
    :Hiển thị thông báo từ chối;
    :Gợi ý chuyển sang nhập văn bản;
    kill
  else (Đồng ý)
    |Người dùng|
    :Nói câu hỏi hoặc yêu cầu;
    
    |Giao diện (Frontend)|
    :Thu âm và truyền dữ liệu âm thanh;
    
    |Hệ thống BK-TBOT|
    :Chuyển giọng nói thành văn bản (STT);
    note right: Sử dụng mô hình SherpaSTT
    
    if (Độ chính xác cao?) then (Không)
      |Giao diện (Frontend)|
      :Hiển thị văn bản thô chưa hoàn chỉnh;
      
      |Người dùng|
      :Chỉnh sửa lại bằng tay và nhấn Gửi;
      
      |Hệ thống BK-TBOT|
    else (Có)
    endif
    
    :Phân tích ngữ nghĩa và sinh câu trả lời;
    :Chuyển văn bản thành giọng nói (TTS);
    note right: Sử dụng mô hình Piper TTS
    :Trả về dữ liệu âm thanh và văn bản;
    
    |Giao diện (Frontend)|
    :Phát âm thanh phản hồi;
    :Hiển thị văn bản tương ứng trên màn hình;
    
    |Người dùng|
    :Nghe và xem câu trả lời;
  endif
  
repeat while (Tiếp tục trò chuyện?) is (Có)
-> Không;
:Đóng kết nối và kết thúc phiên;

stop

@enduml