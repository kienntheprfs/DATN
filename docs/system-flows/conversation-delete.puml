@startuml DeleteConversationActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Xóa phiên hội thoại

|Người dùng|
start
:Tại màn hình Lịch sử hội thoại;
:Nhấn biểu tượng "Xóa" (Thùng rác) trên một phiên;

|Giao diện (Frontend)|
:Hiển thị hộp thoại (Pop-up) xác nhận xóa;

|Người dùng|
if (Xác nhận xóa?) then (Đồng ý)
  |Giao diện (Frontend)|
  :Gửi yêu cầu xóa luồng hội thoại;
  
  |Hệ thống BK-TBOT|
  :Cập nhật trạng thái bản ghi\n(Soft Delete);
  note right: Ẩn khỏi hệ thống thay vì\nxóa vĩnh viễn dữ liệu
  :Trả về kết quả thành công;
  
  |Giao diện (Frontend)|
  :Xóa phiên khỏi danh sách hiển thị;
  :Hiển thị thông báo "Đã xóa thành công";
else (Hủy bỏ)
  |Giao diện (Frontend)|
  :Đóng hộp thoại xác nhận;
  :Giữ nguyên trạng thái danh sách;
endif

stop

@enduml