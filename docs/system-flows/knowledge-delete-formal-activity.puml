@startuml DeleteFormalDocumentActivity
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Xóa Tài liệu Formal (LightRAG Document)

|Người dùng|
start
:Người dùng gửi yêu cầu xóa formal document;
:Thiết lập is_formal_doc=True;

|Giao diện (API)|
:Gọi DELETE /documents/{document_id}?is_formal_doc=True;

|Hệ thống BK-TBOT|
:Tìm formal_document trong Database;

if (Document tồn tại?) then (Có)
  :Sync từ LightRAG (get_track_result);
  note right: Cập nhật lightrag_doc_id\ntừ track result mới nhất
  
  if (LightRAG enabled?) then (Có)
    :Delete document khỏi LightRAG;
    note right: Gọi LightRAG API\nđể remove doc_id
    
    note left: Nếu thất bại → warning log\nvà tiếp tục xóa file
  endif
  
  :Delete file khỏi Storage (S3);
  note right: Xóa raw/formal/{track_id}/{filename}
  note left: Nếu thất bại → warning log
  
  :Delete formal_document record;
  note right: Xóa vĩnh viễn khỏi\nPostgreSQL (không soft delete)
  
  :Commit changes;
  
  :Trả về success (204 No Content);
  
  |Giao diện (API)|
  :Trả về 204 OK;
  
  |Người dùng|
  :Xác nhận đã xóa thành công;

else (Không)
  :Báo lỗi 404 (Document not found);
  
  |Giao diện (API)|
  :Trả về lỗi 404;
  
  |Người dùng|
  :Nhận thông báo lỗi;
  stop
@enduml
@enduml