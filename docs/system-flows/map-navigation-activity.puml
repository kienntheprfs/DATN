@startuml MapNavigationActivitySimplified
!theme plain
skinparam ParticipantPadding 30
skinparam BoxPadding 30
skinparam MinClassWidth 140
skinparam swimlaneWidth 250

<style>
activityDiagram {
  swimlane {
    BackgroundColor #E8E8E8
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 16
    FontStyle bold
  }
  activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    FontSize 15
    RoundCorner 15
  }
  diamond {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
    FontColor #E65100
    FontSize 14
  }
  arrow {
    LineColor #424242
    LineThickness 2.5
    FontSize 13
  }
  note {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontColor #333333
    FontSize 13
  }
}
</style>

title Luồng Tìm đường (Trang Bản đồ)

|Người dùng|
start
:Truy cập trang "Bản đồ" (Navigation);

|Giao diện (Frontend)|
:Yêu cầu tải dữ liệu bản đồ;

|Hệ thống BK-TBOT|
:Truy xuất dữ liệu các tòa nhà/địa điểm;

|Giao diện (Frontend)|
:Hiển thị bản đồ tương tác;

|Người dùng|
:Thao tác chọn Điểm xuất phát và Điểm đến;

|Giao diện (Frontend)|
:Gửi thông tin tọa độ/địa điểm cần tìm;

|Hệ thống BK-TBOT|
:Tính toán lộ trình tối ưu;
note right: Áp dụng thuật toán tìm đường\n(Dijkstra / NetworkX)
:Trả về dữ liệu lộ trình chi tiết;

|Giao diện (Frontend)|
:Vẽ trực quan đường đi trên bản đồ;
:Hiển thị danh sách các bước di chuyển\n(thời gian, khoảng cách);

|Người dùng|
:Xem tổng thể lộ trình và\nđọc hướng dẫn di chuyển;

stop

@enduml