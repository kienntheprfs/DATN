@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle

actor "Quản trị viên" as Admin

rectangle "Hệ thống Quản trị BK-TBOT (Admin Portal)" {
    
    usecase "Đăng nhập hệ thống" as UC_Login

    package "Phân hệ Quản lý Tri thức" {
        usecase "Quản lý Tài liệu (Thêm/Xóa File)" as UC_Doc
        usecase "Quản lý Hỏi - Đáp (CRUD FAQ)" as UC_FAQ
        usecase "Cập nhật & Đồng bộ tri thức AI" as UC_Sync
        usecase "Thử nghiệm Chatbot" as UC_Test
    }

    package "Phân hệ Quản lý Bản đồ" {
        usecase "Quản lý Điểm mốc (Node)" as UC_Node
        usecase "Quản lý Đoạn đường (Edge)" as UC_Edge
        usecase "Lưu và Triển khai đồ thị" as UC_DeployMap
    }

    package "Phân hệ Giám sát & Thống kê" {
        usecase "Xem Dashboard Tổng quan" as UC_Dash
        usecase "Theo dõi Chủ đề phổ biến" as UC_Topics
        usecase "Xử lý Câu hỏi chưa có câu trả lời" as UC_Unanswered
        usecase "Quản lý Phản hồi & Đánh giá" as UC_Feedback
        usecase "Giám sát dịch vụ tìm đường" as UC_MapErr
    }

    package "Phân hệ Hệ thống" {
        usecase "Quản lý Tài khoản (Thêm/Khóa/Phân quyền)" as UC_Account
    }
    
    ' Định nghĩa quan hệ Include (Bắt buộc phải đăng nhập)
    UC_Doc .u.> UC_Login : <<include>>
    UC_Node .u.> UC_Login : <<include>>
    UC_Dash .u.> UC_Login : <<include>>
    UC_Account .u.> UC_Login : <<include>>
}

' Kết nối Actor với các Use Case
Admin --> UC_Login

Admin --> UC_Doc
Admin --> UC_FAQ
Admin --> UC_Sync
Admin --> UC_Test

Admin --> UC_Node
Admin --> UC_Edge
Admin --> UC_DeployMap

Admin --> UC_Dash
Admin --> UC_Topics
Admin --> UC_Unanswered
Admin --> UC_Feedback
Admin --> UC_MapErr

Admin --> UC_Account

@enduml