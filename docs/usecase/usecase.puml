@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam usecase {
    BackgroundColor white
    BorderColor black
}
skinparam rectangle {
    BorderColor black
    BackgroundColor transparent
}

' --- 1. ĐỊNH NGHĨA ACTORS ---
actor "Người dùng khách" as Guest
actor "Người dùng\nđã đăng nhập" as LoggedIn
actor "Quản trị viên" as Admin

' User đăng nhập kế thừa User khách
LoggedIn -up-|> Guest

' --- 2. HỆ THỐNG BK-TBOT ---
rectangle "Hệ thống BK-TBOT" {
    
    ' --- NHÓM XÁC THỰC ---
    together {
        usecase "Xác thực người dùng" as UC_Auth
        usecase "Đăng ký tài khoản" as UC_Register
        usecase "Đăng nhập" as UC_Login
        usecase "Đăng nhập bằng Google" as UC_LoginGoogle
        
        UC_Login -up-|> UC_Auth
        UC_LoginGoogle -up-|> UC_Auth
    }
    
    ' --- NHÓM TƯƠNG TÁC (NGƯỜI DÙNG) ---
    together {
        usecase "Đặt câu hỏi" as UC_Chat
        usecase "Hỏi đáp thông tin\n(Chế độ thường)" as UC_Normal
        usecase "Hỏi đáp chuyên sâu\n(deep mode)" as UC_Deep
        usecase "Tra cứu sự kiện" as UC_Event
        
        UC_Normal -up-|> UC_Chat
        UC_Deep -up-|> UC_Chat
        UC_Event -up-|> UC_Chat
        
        usecase "Yêu cầu chỉ đường" as UC_Map
        usecase "Tương tác giọng nói" as UC_Voice
        usecase "Đánh giá câu trả lời" as UC_Rate
        
        ' Extend đúng chuẩn: Mũi tên chĩa TỪ chức năng phụ VÀO chức năng chính
        UC_Voice .up.> UC_Chat : <<extend>>
        UC_Rate .up.> UC_Chat : <<extend>>
        UC_Map .up.> UC_Event : <<extend>>
        
        usecase "Quản lý lịch sử hội thoại" as UC_History
    }

    ' --- NHÓM QUẢN TRỊ VIÊN ---
    together {
        usecase "Quản lý tri thức" as UC_ManageKB
        usecase "Quản lý bản đồ" as UC_ManageMap
        usecase "Quản lý tài khoản" as UC_ManageUser
        usecase "Xem bảng điều khiển\ntổng quan" as UC_Dash
        
        usecase "Theo dõi chủ đề\ncâu hỏi phổ biến" as UC_TrackTopic
        usecase "Theo dõi câu hỏi hệ thống\nchưa trả lời được" as UC_TrackUnanswered
        usecase "Quản lý đánh giá\nngười dùng" as UC_TrackRate
        usecase "Theo dõi tình trạng\nbản đồ" as UC_TrackMap
        
        ' Extend cho Dashboard
        UC_TrackTopic .up.> UC_Dash : <<extend>>
        UC_TrackUnanswered .up.> UC_Dash : <<extend>>
        UC_TrackRate .up.> UC_Dash : <<extend>>
        UC_TrackMap .up.> UC_Dash : <<extend>>
    }
}

' --- 3. KẾT NỐI ACTOR VÀ USE CASE ---
' Guest
Guest --> UC_Auth
Guest --> UC_Register
Guest --> UC_Normal
Guest --> UC_Event
Guest --> UC_Map

' Logged In
LoggedIn --> UC_Deep
LoggedIn --> UC_History

' Admin
Admin --> UC_Login
Admin --> UC_ManageKB
Admin --> UC_ManageMap
Admin --> UC_ManageUser
Admin --> UC_Dash

@enduml