# Wayfinder Database Configuration

# ============================================
# OPTION 1: Local / Individual fields
# ============================================
WAYFINDER_DB_USER=postgres
WAYFINDER_DB_PASSWORD=postgres
WAYFINDER_DB_HOST=localhost
WAYFINDER_DB_PORT=5432
WAYFINDER_DB_NAME=knowledge_db
WAYFINDER_DB_SCHEMA=wayfinder

# ============================================
# OPTION 2: Full DB URL (cho Cloud DB / Supabase / AWS RDS / v.v.)
# ============================================
# Priority cao hơn Option 1. Dùng cái này cho DB cloud.
#
# Ví dụ Supabase:
# WAYFINDER_DB_URL=postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres
#
# Ví dụ Neon (postgres cloud):
# WAYFINDER_DB_URL=postgresql://user:pass@ep-xxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# AWS RDS / Google Cloud SQL:
# WAYFINDER_DB_URL=postgresql://user:pass@your-host.amazonaws.com:5432/dbname
#
# Local thay vì Option 1:
# WAYFINDER_DB_URL=postgresql://postgres:postgres@localhost:5432/wayfinder
