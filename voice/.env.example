# Voice Server Configuration
# Set to true to use agent-service-toolkit API instead of Ollama
USE_AGENT_API=true

# Agent-service-toolkit API URL
AGENT_API_URL=http://localhost:8080

# Default agent ID (can be overridden from frontend)
AGENT_ID=chatbot

# Model to use for voice (optional, can be overridden from frontend)
# VOICE_MODEL=gpt-5-nano

# Authentication secret (if agent-service-toolkit requires it)
# AUTH_SECRET=your-secret-key

# If USE_AGENT_API=false, use Ollama instead
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
